{
  "name": "1on1トーク",
  "short_name": "トーク",
  "description": "ふたりだけの1対1トーク。ルームを作ってURLを送るだけ。既読つきチャットと無料音声通話。",
  "lang": "ja",
  "dir": "ltr",
  "id": "./talk.html",
  "start_url": "./talk.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#ffb970",
  "theme_color": "#f2761f",
  "icons": [
    {
      "src": "./talk-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./talk-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./talk-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
